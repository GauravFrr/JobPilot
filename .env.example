# PostgreSQL Database Configuration
POSTGRES_DB=jobpilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_here@postgres:5432/jobpilot

# Redis Cache/Broker Configuration
REDIS_URL=redis://redis:6379/0

# LLM APIs Configuration
GEMINI_API_KEY=your_gemini_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# Security Encryption Key (generate using Fernet)
# Run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
PAIRING_SECRET=some_jwt_or_random_secret_for_pairing

# Port configurations (mostly for Docker setup)
API_PORT=8000
WEB_PORT=3000
